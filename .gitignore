external_repos/*
external/
!external_repos/README.md
!external_repos/.gitkeep

data/
results/
downloads/

# Local historical experiment archive. Contents are deliberately moved out of
# results/ so stale runs cannot be selected accidentally; only the manifest and
# archive README are versioned.
/archive/experiments/

__pycache__/
.pytest_cache/
.agents/
.codex/
*.pyc
.env
.venv/
.DS_Store
build/
dist/
*.egg-info/
*.tmp
*.ckpt
*.pt
*.pth
*.pkl
*.zst
.eggs/

*.bak*

# Content-addressed runtime feature cache; deterministic and safe to rebuild.
data/terpene_feature_cache/

# Private/local candidate libraries: never commit raw or derived private sequence data.
/local_candidate_libraries/
# Local reports and ad-hoc local helpers; never version generated/private workspace material.
/reports/
/scripts/candidate_libraries/

# Unrelated/local development surfaces are kept on developer machines but are
# not part of the scientific release index.
/src/experimental_touch_cascade/
/configs/experimental_touch/
/projects/planned/

# Retired local-only research/UI branches. They may remain on a developer machine for
# historical inspection, but they are not part of the current Catalyst production tree.
/scripts/pocket/
/projects/active/pocket_robustness/
/frontend/terpene_portal/
/scripts/terpene_portal/

# Large external pretrained weights (local research assets)
external_models/

# Isolated third-party runtimes and bundled model assets
external_runtime/
