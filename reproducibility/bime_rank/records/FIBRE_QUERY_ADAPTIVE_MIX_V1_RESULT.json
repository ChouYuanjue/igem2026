  "posthoc_design": {
    "trainable_parameters": 513,
    "form": "one linear map from the frozen 512-dimensional protein hidden state to sigmoid local mass",
    "initialization": "zero weight; bias copied from the trained v2 E2R global mix logit",
    "frozen_parameters": "all FIBRE-Modes base parameters",
    "training_objective": "existing E2R multi-positive contrastive plus existing Top-3/10/20 surrogate; same epochs/lr/weight decay",
    "r2e_invariance": "exact by construction; protein-side mix gate is not read by R2E",
    "frozen_mean_local_mass": 0.43800882808864117,
    "frozen_mean_query_std": 0.028872333001345354
  },
  "decision": {
    "end_to_end_both": "rejected_in_development_due_to_large_r2e_regression",
    "end_to_end_e2r_only": "rejected_in_development_because_shared_training_still_regressed_r2e",
    "posthoc_e2r": "not_promoted",
    "reason": "The frozen-core gate preserves R2E exactly and gives small E2R early-hit/MRR point gains, but paired bootstrap intervals for E2R MRR and most Top-K deltas cross zero while best-positive rank worsens. The extra gate therefore does not justify changing the frozen FIBRE-Modes readout."
  },
  "claim_boundary": [
    "Current FIBRE-Modes keeps the direction-level universal/local mass scalars.",
    "The adaptive gate remains a tested negative/neutral branch, not a current inference component.",
    "Query-specific extensibility is provided by the separately validated scientific-evidence layer rather than this generic core gate."
  ],
